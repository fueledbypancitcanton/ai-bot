# Copy this file to ".env" and fill in your key.
# Get a free key at https://console.groq.com/keys

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: which Groq model to use (default: openai/gpt-oss-120b)
# See available models for your key: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Optional: port the API server listens on (default 8787)
PORT=8787
